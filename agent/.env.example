# Ollama Configuration
# Available models: gemma3, gpt-oss:20b-cloud, nomic-embed-text
OLLAMA_MODEL=gemma3
OLLAMA_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434

# Directory Configuration
DOCS_DIR=./docs
PROMPTS_DIR=./prompts

# Codebase Analysis Configuration
# Set to false to include full file contents in LLM context
# Set to true to only include summaries (faster, less detailed)
CODEBASE_SUMMARY_ONLY=false

# Maximum file size to include in analysis (in KB)
CODEBASE_MAX_FILE_SIZE=200

# Debug Mode (set to 'true' for detailed error output)
DEBUG=false
