# Must be an Ollama model with tool-calling support (checked at startup).
# gemma3 does NOT support tools. Pull the default with: ollama pull qwen2.5:7b-instruct
AGENT_MODEL=qwen2.5:7b-instruct
OLLAMA_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434

# Tools can only read and write inside this directory (default: where you start the CLI).
# AGENT_ROOT=..

# Per-request limits; the run ends with a notice when one is reached.
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_TOOL_CALLS=20

# Never set LANGSMITH_TRACING / LANGCHAIN_TRACING_V2 / LANGSMITH_API_KEY:
# the agent refuses to start with them, because they send data off the machine.

# true prints each model and tool step (local only) and error stack traces.
DEBUG=false
