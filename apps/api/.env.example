PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:8080

# OpenAI API Key (for RAG, chat, and Whisper STT)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (for local RAG)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=gemma3

# Whisper Configuration (for voice agent)
# Monthly spending limit for Whisper API (in USD)
WHISPER_MONTHLY_LIMIT=10

# Vector Database (optional - for RAG)
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_ENVIRONMENT=your_pinecone_environment

# Azure OpenAI (alternative)
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_ENDPOINT=your_azure_endpoint

# Speech Services (for voice agent - alternative to Whisper)
# AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=your_azure_region
