PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# true prints each LangChain step (retrieval, model call) of RAG queries. Local only.
DEBUG=false
CORS_ORIGIN=http://localhost:8080

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_services_rag

# Ollama Configuration (local LLM for RAG embeddings + booking chat)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=gemma3
# Max seconds to wait for Ollama before falling back to a scripted reply
OLLAMA_TIMEOUT_MS=30000

# Opt-in booking agent (docs/booking-agent-design.md): the model checks real
# availability and books through tools, so it cannot confirm a slot it did not
# write. Slower on CPU (each tool call is another model pass), so off by default.
BOOKING_AGENT=false
# Must support tool calling (gemma3 does not); checked at startup when enabled.
BOOKING_AGENT_MODEL=qwen2.5:7b-instruct
# Whole-turn budget (several model calls) before the scripted fallback.
BOOKING_AGENT_TIMEOUT_MS=90000

# Speech-to-text runs locally via transformers.js (no API key, no cost).
# Model is downloaded once from the Hugging Face Hub and cached.
WHISPER_MODEL=Xenova/whisper-base.en

# Vestigial: STT is local and free, so this cap is never hit. Kept for the
# usage-stats endpoint until the quota subsystem is retired.
WHISPER_MONTHLY_LIMIT=10
